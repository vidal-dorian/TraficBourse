# Copy this file to `.env` and adjust the values. Never commit `.env`.

# Path of the SQLite database file (created on first use, parent folder included).
# Local default: ./data/bourse.db. In Docker, docker-compose.yml sets it to
# /data/bourse.db, backed by BOURSE_DATA_DIR on the host (below).
DATABASE_PATH=./data/bourse.db

# Cloudflare Access check on /admin (CLAUDE.md §8). Cloudflare Access guards /admin at
# the edge; the app also verifies the `Cf-Access-Jwt-Assertion` token. If any of the
# three values below is missing, /admin answers 403 (fail closed).
# Access team domain, host name only (Zero Trust > Settings > Custom pages).
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# Application Audience (AUD) tag of the Access application protecting /admin.
CF_ACCESS_AUD=
# Admin e-mails allowed on /admin, comma-separated, case-insensitive.
ADMIN_EMAILS=admin@example.com

# Local dev only: set to `true` to skip the Access check on /admin. Ignored when
# NODE_ENV=production (the production image always checks the token).
ADMIN_AUTH_DISABLED=false

# --- Docker Compose (docker-compose.yml, see DEPLOY.md) ---
# Read by `docker compose` from the `.env` next to docker-compose.yml. The defaults suit the Pi.

# Host folder holding the SQLite file, on the 40 GB data disk (never the system USB key).
# BOURSE_DATA_DIR=/mnt/data/bourse

# Image tag to pull and run: latest, or the full commit SHA of a previous image to roll back
# (CI tags every image it pushes to GHCR with both).
# IMAGE_TAG=latest

# Image platform: linux/arm64 on the Pi, linux/amd64 to build and run on an x86 machine.
# PLATFORM=linux/arm64

# Host port of the web container (Caddy reverse-proxies to it).
# WEB_PORT=3000

# Host address the web port is published on. Keep 127.0.0.1 behind the host Caddy: any other
# value (0.0.0.0, a LAN address) lets clients reach the app without going through Cloudflare,
# skipping Cloudflare Access on /admin and the rate limit on /api/mcp. Docker's port rules
# bypass ufw, so a host firewall does not protect a port published on every interface.
# WEB_BIND=127.0.0.1
