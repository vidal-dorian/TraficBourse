# Copy this file to `.env` and adjust the values. Never commit `.env`.

# Path of the SQLite database file (created on first use, parent folder included).
# Local default: ./data/bourse.db. In Docker, docker-compose.yml sets it to
# /data/bourse.db, backed by BOURSE_DATA_DIR on the host (below).
DATABASE_PATH=./data/bourse.db

# --- Docker Compose (docker-compose.yml, see DEPLOY.md) ---
# Read by `docker compose` from the `.env` next to docker-compose.yml. The defaults suit the Pi.

# Host folder holding the SQLite file, on the 40 GB data disk (never the system USB key).
# BOURSE_DATA_DIR=/mnt/data/bourse

# Image tag to run: latest, or a previous tag to roll back.
# IMAGE_TAG=latest

# Image platform: linux/arm64 on the Pi, linux/amd64 to build and run on an x86 machine.
# PLATFORM=linux/arm64

# Host port of the web container (Caddy reverse-proxies to it).
# WEB_PORT=3000
